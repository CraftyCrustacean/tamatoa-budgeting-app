<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground">

    <!-- category dot-->
    <View
        android:id="@+id/colourDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/dot_category"/>

    <!-- description and date stacked on each other -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!--     category name for title     -->
            <TextView
                android:id="@+id/categoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- the recurring marker -->
            <TextView
                android:id="@+id/recurringMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>

            <!-- Photo mark -->
            <TextView
                android:id="@+id/photoMarc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ඞ"
                android:textSize="13sp"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!--    the date part    -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- expense amount on the right in red -->
    <TextView
        android:id="@+id/amountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E04848"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"/>
</LinearLayout>